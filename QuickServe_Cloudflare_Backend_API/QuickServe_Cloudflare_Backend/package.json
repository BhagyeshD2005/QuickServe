{
  "name": "quickserve-cloudflare-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply quickserve-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quickserve-db --remote",
    "db:seed:local": "wrangler d1 execute quickserve-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute quickserve-db --remote --file=./seed.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.9.7",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0"
  }
}